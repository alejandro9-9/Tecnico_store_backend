# Local SQLite is used when DATABASE_URL is omitted.
# Neon example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Set to the public origin of the Streamlit frontend on Render.
FRONTEND_ORIGIN=http://localhost:8501

# Optional: rules (default) or gemini. The app falls back to rules on provider errors.
AI_PROVIDER=rules
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
